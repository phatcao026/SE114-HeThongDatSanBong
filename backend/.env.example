APP_NAME=backend
SERVER_PORT=8080

POSTGRES_VERSION=16
POSTGRES_DB=se114_db
POSTGRES_USER=se114_user
POSTGRES_PASSWORD=se114_password
POSTGRES_PORT=5432
TZ=Asia/Ho_Chi_Minh

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/se114_db
SPRING_DATASOURCE_USERNAME=se114_user
SPRING_DATASOURCE_PASSWORD=se114_password

SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_VALIDATE_MIGRATION_NAMING=true

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=true
SPRING_JPA_OPEN_IN_VIEW=false

JWT_SECRET=dev-only-change-this-secret-before-production-2026
