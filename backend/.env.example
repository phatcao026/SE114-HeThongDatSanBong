APP_NAME=backend
SERVER_PORT=8080

# Database Configuration (Docker)
POSTGRES_VERSION=16
POSTGRES_DB=se114_db
POSTGRES_USER=se114_user
POSTGRES_PASSWORD=se114_password
POSTGRES_PORT=5432
TZ=Asia/Ho_Chi_Minh

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/se114_db
SPRING_DATASOURCE_USERNAME=se114_user
SPRING_DATASOURCE_PASSWORD=se114_password

# Flyway Migration
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_VALIDATE_MIGRATION_NAMING=true

# JPA & Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=true
SPRING_JPA_OPEN_IN_VIEW=false

# Security & JWT
JWT_SECRET=your_very_long_secure_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Stripe Payment Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Supabase Storage Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET_NAME=images

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_MODEL=llama-3.3-70b-versatile

# Dev Seeding Configuration (Required if app.seed.enabled=true in application.properties)
APP_SEED_ADMIN_EMAIL=admin@example.com
APP_SEED_ADMIN_PASSWORD=123456
APP_SEED_OWNER_EMAIL=owner@example.com
APP_SEED_OWNER_PASSWORD=123456
APP_SEED_PLAYER_EMAIL=player@example.com
APP_SEED_PLAYER_PASSWORD=123456
APP_SEED_OPPONENT_EMAIL=opponent@example.com
APP_SEED_OPPONENT_PASSWORD=123456
