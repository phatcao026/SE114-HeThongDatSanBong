<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    tools:context=".ui.customer.MatchmakingActivity">

    <!-- App bar -->
    <LinearLayout
        android:id="@+id/layoutAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingTop="@dimen/spacing_5"
        android:paddingBottom="@dimen/spacing_3"
        android:background="@color/background_secondary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/matchmaking_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_heading1"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque" />

        <ImageView
            android:id="@+id/ivNotifications"
            android:layout_width="@dimen/spacing_8"
            android:layout_height="@dimen/spacing_8"
            android:padding="@dimen/spacing_2"
            android:src="@drawable/ic_bell"
            app:tint="@color/text_secondary"
            android:background="@drawable/ripple_primary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_notifications" />
    </LinearLayout>

    <!-- Segmented tabs -->
    <LinearLayout
        android:id="@+id/layoutSegment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/spacing_4"
        android:layout_marginTop="@dimen/spacing_3"
        android:padding="4dp"
        android:background="@drawable/bg_segment_container"
        app:layout_constraintTop_toBottomOf="@id/layoutAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_all"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@drawable/bg_segment_active"
            android:textColor="@color/text_on_primary" />

        <TextView
            android:id="@+id/tabOpponent"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_find_opponent"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@android:color/transparent"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tabMember"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_find_member"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@android:color/transparent"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tabSuggested"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_history"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@android:color/transparent"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Count row -->
    <LinearLayout
        android:id="@+id/layoutCountRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="@dimen/spacing_4"
        android:layout_marginTop="@dimen/spacing_4"
        app:layout_constraintTop_toBottomOf="@id/layoutSegment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvMatchCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/be_vietnam_pro" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/match_updated"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro" />
    </LinearLayout>

    <!-- Match list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMatches"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_3"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingBottom="@dimen/nav_container_height"
        app:layout_constraintTop_toBottomOf="@id/layoutCountRow"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvEmptyMatches"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:text="@string/empty_matches"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_large"
        android:fontFamily="@font/be_vietnam_pro"
        android:layout_marginHorizontal="@dimen/spacing_6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Create Post FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreatePost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_4"
        android:layout_marginBottom="@dimen/spacing_4"
        android:src="@drawable/ic_plus"
        app:tint="@color/text_on_primary"
        app:backgroundTint="@color/primary"
        app:elevation="4dp"
        android:contentDescription="Tạo bài đăng"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_customer_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
