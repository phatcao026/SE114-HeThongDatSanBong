<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvAdminAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/text_heading"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="PK"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Quản trị"
                android:textColor="@color/text_heading"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_heading"
                android:contentDescription="Search" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_admin_notifications"
                    app:tint="@color/text_heading"
                    android:contentDescription="Notifications" />
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/shape_nav_dot"
                    android:backgroundTint="@color/admin_alert_text" />
            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- GMV Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/admin_gmv_card_bg"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GMV TUẦN NÀY"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp"
                            android:textAllCaps="true" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_nav_item_active"
                                android:backgroundTint="#1F2F24"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="● Realtime"
                                android:textColor="@color/primary"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="1,84 tỷ đ"
                        android:textColor="@android:color/white"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="↗ +18.6% so với tuần trước"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />

                    <!-- Placeholder for Chart -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="24dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="#3360D86E" />
                        <View android:layout_width="0dp" android:layout_height="12dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="#3360D86E" />
                        <View android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="#3360D86E" />
                        <View android:layout_width="0dp" android:layout_height="14dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="#3360D86E" />
                        <View android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="#3360D86E" />
                        <View android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="@color/primary" />
                        <View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="#3360D86E" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stats Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:rowCount="2">
                <include android:id="@+id/cardGmv" layout="@layout/layout_admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" />
                <include android:id="@+id/cardUsers" layout="@layout/layout_admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" />
                <include android:id="@+id/cardFields" layout="@layout/layout_admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" />
                <include android:id="@+id/cardBookings" layout="@layout/layout_admin_stat_card" android:layout_width="0dp" android:layout_columnWeight="1" />
            </GridLayout>

            <!-- Alerts -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Cần kiểm duyệt"
                android:textColor="@color/text_heading"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/admin_alert_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_admin_alert_card"
                        android:backgroundTint="#FEE2E2"
                        android:padding="12dp"
                        android:src="@drawable/ic_bolt"
                        app:tint="@color/admin_alert_text"
                        android:contentDescription="Alert icon" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 báo cáo đang chờ"
                            android:textColor="@color/admin_alert_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 ưu tiên cao · 1 sân ảo nghi vấn"
                            android:textColor="#9B2C2C"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAudit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/text_heading"
                        android:text="Xem →"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        app:cornerRadius="24dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Platform Health -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Sức khỏe nền tảng"
                android:textColor="@color/text_heading"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">
                    <include layout="@layout/layout_admin_health_item" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_gray" />
                    <include layout="@layout/layout_admin_health_item" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_gray" />
                    <include layout="@layout/layout_admin_health_item" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_gray" />
                    <include layout="@layout/layout_admin_health_item" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Admin Bottom Navigation -->
    <include layout="@layout/layout_admin_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>