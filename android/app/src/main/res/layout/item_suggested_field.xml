<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_3"
    android:minWidth="@dimen/home_suggested_card_width"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/background_primary"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_suggested_image_height">

            <ImageView
                android:id="@+id/ivFieldImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/background_tertiary"
                android:contentDescription="@string/cd_field_image" />

            <TextView
                android:id="@+id/tvFieldType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/spacing_3"
                android:layout_marginBottom="@dimen/spacing_3"
                android:paddingStart="@dimen/spacing_2"
                android:paddingEnd="@dimen/spacing_2"
                android:paddingTop="@dimen/spacing_1"
                android:paddingBottom="@dimen/spacing_1"
                android:background="@drawable/bg_badge_green"
                android:text="@string/suggested_field_type_7"
                android:textColor="@color/badge_green_text"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:fontFamily="@font/inter" />

            <TextView
                android:id="@+id/tvHotBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="@dimen/spacing_3"
                android:layout_marginEnd="@dimen/spacing_3"
                android:paddingStart="@dimen/spacing_2"
                android:paddingEnd="@dimen/spacing_2"
                android:paddingTop="@dimen/spacing_1"
                android:paddingBottom="@dimen/spacing_1"
                android:background="@drawable/bg_badge_orange"
                android:text="@string/badge_hot"
                android:textColor="@color/badge_orange_text"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:fontFamily="@font/inter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_3">

            <TextView
                android:id="@+id/tvFieldName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_medium"
                android:textStyle="bold"
                android:fontFamily="@font/inter"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="@dimen/spacing_16"
                    android:layout_height="@dimen/spacing_16"
                    android:src="@drawable/ic_star"
                    app:tint="@color/warning"
                    android:contentDescription="@string/cd_field_rating" />

                <TextView
                    android:id="@+id/tvFieldRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_1"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_small"
                    android:fontFamily="@font/inter" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
