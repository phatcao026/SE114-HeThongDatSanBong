<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvMenuIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/ivMenuIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:src="@drawable/ic_person"
            app:tint="@color/text_hint" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvMenuLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:text="Menu Item"
        android:textColor="@color/text_heading"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvMenuBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_nav_item_active"
        android:backgroundTint="#F0FDF4"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="Hiện tại"
        android:textColor="@color/primary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivMenuChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_admin_chevron_right" />

</LinearLayout>