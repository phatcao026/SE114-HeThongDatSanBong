<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_top"
    android:padding="@dimen/spacing_6">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tạo đội bóng mới"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_heading3"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="@dimen/spacing_40"
            android:layout_height="@dimen/spacing_40"
            android:padding="@dimen/spacing_2"
            android:src="@drawable/ic_cancel_circle"
            app:tint="@color/text_secondary"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toTopOf="@id/btnSave">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="@dimen/spacing_4">

            <!-- Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTeamName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tên đội"
                app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                app:boxCornerRadiusBottomStart="@dimen/radius_button"
                app:boxCornerRadiusTopEnd="@dimen/radius_button"
                app:boxCornerRadiusTopStart="@dimen/radius_button"
                app:boxStrokeColor="@color/border">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTeamName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Level -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTeamLevel"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_3"
                android:hint="Trình độ"
                app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                app:boxCornerRadiusBottomStart="@dimen/radius_button"
                app:boxCornerRadiusTopEnd="@dimen/radius_button"
                app:boxCornerRadiusTopStart="@dimen/radius_button"
                app:boxStrokeColor="@color/border">

                <AutoCompleteTextView
                    android:id="@+id/actvTeamLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Description -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTeamDescription"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_3"
                android:hint="Mô tả đội bóng (tùy chọn)"
                app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                app:boxCornerRadiusBottomStart="@dimen/radius_button"
                app:boxCornerRadiusTopEnd="@dimen/radius_button"
                app:boxCornerRadiusTopStart="@dimen/radius_button"
                app:boxStrokeColor="@color/border"
                app:counterEnabled="true"
                app:counterMaxLength="150">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTeamDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_4"
        android:text="Lưu"
        android:textSize="@dimen/text_body_large"
        android:textStyle="bold"
        android:textColor="@color/text_on_primary"
        android:fontFamily="@font/be_vietnam_pro"
        app:backgroundTint="@color/primary"
        app:cornerRadius="@dimen/radius_button"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
