<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    tools:context=".ui.customer.TeamManagementActivity">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/layoutToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingTop="@dimen/spacing_5"
        android:paddingBottom="@dimen/spacing_3"
        android:background="@color/background_secondary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/spacing_40"
            android:layout_height="@dimen/spacing_40"
            android:padding="@dimen/spacing_2"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"
            android:background="@drawable/ripple_primary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_3"
            android:text="Đội bóng"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_heading3"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque" />
    </LinearLayout>

    <!-- Tab selector: My Teams / Invitations -->
    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/spacing_4"
        android:layout_marginTop="@dimen/spacing_3"
        android:padding="4dp"
        android:background="@drawable/bg_segment_container"
        app:layout_constraintTop_toBottomOf="@id/layoutToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabMyTeams"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Đội của tôi"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@drawable/bg_segment_active"
            android:textColor="@color/text_on_primary" />

        <TextView
            android:id="@+id/tabInvitations"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Lời mời"
            android:textSize="@dimen/text_body_small"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@android:color/transparent"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Teams List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTeams"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_3"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Invitations List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInvitations"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_3"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingBottom="80dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty states -->
    <TextView
        android:id="@+id/tvEmptyTeams"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:text="Bạn chưa có đội bóng nào"
        android:textColor="@color/text_hint"
        android:textSize="@dimen/text_body_medium"
        android:fontFamily="@font/be_vietnam_pro"
        android:layout_marginHorizontal="@dimen/spacing_6"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvEmptyInvitations"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:text="Không có lời mời nào"
        android:textColor="@color/text_hint"
        android:textSize="@dimen/text_body_medium"
        android:fontFamily="@font/be_vietnam_pro"
        android:layout_marginHorizontal="@dimen/spacing_6"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FAB: Create Team -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateTeam"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_4"
        android:src="@drawable/ic_plus"
        android:contentDescription="Tạo đội mới"
        app:tint="@color/text_on_primary"
        app:backgroundTint="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
