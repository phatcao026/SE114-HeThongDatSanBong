<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_create_field.xml  ─  CreateFieldBottomSheetFragment
    Trigger: FAB (+) in FieldManagementFragment or btnNewField in DashboardFragment
    Usage:
        CreateFieldBottomSheetFragment sheet = new CreateFieldBottomSheetFragment();
        sheet.show(getSupportFragmentManager(), "CreateFieldSheet");
    Java class extends: BottomSheetDialogFragment
    Inflate with: View.inflate(context, R.layout.dialog_create_field, null)

    Fields collected:
      - etFieldName        → String: field name
      - tvTypeSan5/7/11    → selected type chip
      - etCapacity         → int: max players
      - etPricePerSlot     → long: price in VND
      - etDescription      → String: optional description
      - ivFieldImage       → Uri: picked image (via ActivityResultLauncher)
      - rbAvailable/Maintenance → boolean: initial status

    On "Lưu" → validate → POST /api/fields → dismiss + refresh list
    On "Hủy" → dismiss()
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/createFieldSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_container"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- ── Drag handle ── -->
        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_bottom_sheet_handle"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

        <!-- ── Title row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tạo sân mới"
                    android:textColor="@color/slate_900"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Điền thông tin để thêm sân vào hệ thống"
                    android:textColor="@color/slate_400"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Close button -->
            <LinearLayout
                android:id="@+id/btnCloseCreateField"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_info_gray"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textColor="@color/slate_500"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════
             SECTION 1: ẢNH SÂN (Field Image Picker)
             ══════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ảnh sân"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Image picker container — tap to launch image picker -->
        <LinearLayout
            android:id="@+id/containerImagePicker"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_image_picker"
            android:layout_marginBottom="20dp">

            <!-- State 1: No image selected (default VISIBLE) -->
            <LinearLayout
                android:id="@+id/llNoImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@color/emerald_100"
                    android:gravity="center"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/emerald_600" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhấn để chọn ảnh sân"
                    android:textColor="@color/emerald_600"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PNG, JPG · Tối đa 5MB"
                    android:textColor="@color/slate_400"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

            <!-- State 2: Image selected (default GONE, set VISIBLE in Java) -->
            <FrameLayout
                android:id="@+id/frameImagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivFieldImagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <!-- Change photo overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="#99000000"
                    android:layout_gravity="bottom">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đổi ảnh"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════
             SECTION 2: TÊN SÂN (Field Name)
             ══════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên sân  *"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_outline_box"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="18dp">

            <EditText
                android:id="@+id/etFieldName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="VD: Sân A1, Sân Bóng 1…"
                android:textColorHint="@color/slate_400"
                android:textColor="@color/slate_900"
                android:textSize="14sp"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:imeOptions="actionNext" />

        </LinearLayout>

        <!-- Error text for field name -->
        <TextView
            android:id="@+id/tvFieldNameError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ Tên sân không được để trống"
            android:textColor="@color/red_500"
            android:textSize="11sp"
            android:layout_marginTop="-14dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- ══════════════════════════════════════════════
             SECTION 3: LOẠI SÂN (Field Type Chips)
             ══════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loại sân  *"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <!-- Sân 5 chip -->
            <LinearLayout
                android:id="@+id/chipTypeSan5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_type_chip_active">
                <!-- Default selected — Java toggles bg_type_chip_active / bg_type_chip_inactive -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sân 5"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 - 10 người"
                    android:textColor="#CCFFffFF"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Sân 7 chip -->
            <LinearLayout
                android:id="@+id/chipTypeSan7"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_type_chip_inactive">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sân 7"
                    android:textColor="@color/slate_600"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7 - 14 người"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Sân 11 chip -->
            <LinearLayout
                android:id="@+id/chipTypeSan11"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_type_chip_inactive">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sân 11"
                    android:textColor="@color/slate_600"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11 - 22 người"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>
        <!-- ══════════════════════════════════════════════
             SECTION 4: SỐ NGƯỜI & GIÁ THUÊ (2-column)
             ══════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <!-- Số người tối đa -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số người tối đa"
                    android:textColor="@color/slate_700"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_outline_box"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <EditText
                        android:id="@+id/etCapacity"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="10"
                        android:textColorHint="@color/slate_400"
                        android:textColor="@color/slate_900"
                        android:textSize="14sp"
                        android:inputType="number"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="người"
                        android:textColor="@color/slate_400"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Giá thuê / khung giờ -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá thuê / giờ  *"
                    android:textColor="@color/slate_700"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_outline_box"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <EditText
                        android:id="@+id/etPricePerSlot"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="350000"
                        android:textColorHint="@color/slate_400"
                        android:textColor="@color/slate_900"
                        android:textSize="14sp"
                        android:inputType="numberDecimal"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₫"
                        android:textColor="@color/emerald_600"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
        <!-- ══════════════════════════════════════════════
             SECTION 5: MÔ TẢ (Description — optional)
             ══════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả sân  (tuỳ chọn)"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_outline_box"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@null"
                android:hint="Mô tả vị trí, tiện ích, cơ sở vật chất của sân…"
                android:textColorHint="@color/slate_400"
                android:textColor="@color/slate_900"
                android:textSize="13sp"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:maxLines="4" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════════
             SECTION 6: TRẠNG THÁI BAN ĐẦU
             ══════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trạng thái ban đầu"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <!-- Available radio -->
            <LinearLayout
                android:id="@+id/rbStatusAvailable"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_radio_active"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_badge_green"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available"
                        android:textColor="@color/emerald_700"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sân đang hoạt động"
                        android:textColor="@color/emerald_600"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- Checkmark indicator -->
                <TextView
                    android:id="@+id/ivCheckAvailable"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_green"
                    android:visibility="visible" />

            </LinearLayout>

            <!-- Maintenance radio -->
            <LinearLayout
                android:id="@+id/rbStatusMaintenance"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_radio_inactive"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_badge_orange"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maintenance"
                        android:textColor="@color/slate_600"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang bảo trì"
                        android:textColor="@color/slate_400"
                        android:textSize="10sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/ivCheckMaintenance"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:text="✓"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_orange"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════
             ACTION BUTTONS
             ══════════════════════════════════════════════ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_100"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Hủy button -->
            <LinearLayout
                android:id="@+id/btnCancelCreateField"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_outline_gray">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hủy"
                    android:textColor="@color/slate_600"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Tạo sân button -->
            <LinearLayout
                android:id="@+id/btnSubmitCreateField"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_btn_primary_green"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tạo sân"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
