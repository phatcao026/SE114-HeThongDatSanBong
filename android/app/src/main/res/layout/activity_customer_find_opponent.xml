<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary">

    <LinearLayout
        android:id="@+id/layoutAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingTop="@dimen/spacing_5"
        android:paddingBottom="@dimen/spacing_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/matchmaking_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_heading3"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingTop="@dimen/spacing_2"
        android:paddingBottom="@dimen/spacing_2"
        app:layout_constraintTop_toBottomOf="@id/layoutAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreatePost"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="@string/action_create_post"
            android:fontFamily="@font/be_vietnam_pro"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickFind"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_3"
            android:text="@string/action_quick_find"
            android:fontFamily="@font/be_vietnam_pro"
            app:backgroundTint="@color/accent_orange"
            app:cornerRadius="@dimen/radius_button" />
    </LinearLayout>

    <!-- Row 1: Scope Filters (All, My, History) -->
    <LinearLayout
        android:id="@+id/layoutScopeFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_4"
        android:layout_marginTop="@dimen/spacing_2"
        app:layout_constraintTop_toBottomOf="@id/layoutActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabScopeAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_4"
            android:text="@string/tab_scope_all"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@drawable/bg_chip_filter_selected"
            android:textColor="@color/text_on_primary"
            android:layout_marginEnd="@dimen/spacing_2" />

        <TextView
            android:id="@+id/tabScopeMy"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_4"
            android:text="@string/tab_my_posts"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@drawable/bg_chip_filter"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="@dimen/spacing_2" />

        <TextView
            android:id="@+id/tabScopeHistory"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_4"
            android:text="@string/tab_history"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@drawable/bg_chip_filter"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Row 2: Type Filters (All, Opponent, Member) -->
    <LinearLayout
        android:id="@+id/layoutTypeFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_4"
        android:layout_marginTop="@dimen/spacing_2"
        app:layout_constraintTop_toBottomOf="@id/layoutScopeFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabTypeAll"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_3"
            android:text="@string/tab_all"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@drawable/bg_chip_filter_selected"
            android:textColor="@color/text_on_primary"
            android:layout_marginEnd="@dimen/spacing_2" />

        <TextView
            android:id="@+id/tabTypeOpponent"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_3"
            android:text="@string/tab_find_opponent"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@drawable/bg_chip_filter"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="@dimen/spacing_2" />

        <TextView
            android:id="@+id/tabTypeMember"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_3"
            android:text="@string/tab_find_member"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:background="@drawable/bg_chip_filter"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="@dimen/spacing_4"
        android:layout_marginTop="@dimen/spacing_3"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/layoutTypeFilters"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvMatchCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/match_count"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/be_vietnam_pro" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/match_updated"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMatches"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_2"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingBottom="@dimen/spacing_4"
        app:layout_constraintTop_toBottomOf="@id/layoutSummary"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvEmptyMatches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/empty_matches_found"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvMatches"
        app:layout_constraintBottom_toBottomOf="@id/rvMatches"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
