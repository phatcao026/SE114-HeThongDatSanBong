<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    tools:context=".ui.customer.FieldDetailActivity">

    <!-- Back button overlay on image -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="@dimen/spacing_40"
        android:layout_height="@dimen/spacing_40"
        android:layout_margin="@dimen/spacing_4"
        android:padding="@dimen/spacing_2"
        android:src="@drawable/ic_arrow_back"
        android:background="@drawable/bg_icon_button_light"
        app:tint="@color/text_primary"
        android:contentDescription="@string/cd_back"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutBookBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Field Image -->
            <ImageView
                android:id="@+id/ivFieldImage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_detail_cover_height"
                android:background="@drawable/bg_pitch_cover_square"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_field_image" />

            <!-- Content Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_4"
                android:background="@color/background_secondary"
                android:layout_marginTop="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/spacing_3">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_orange_solid"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:paddingHorizontal="@dimen/spacing_2"
                        android:paddingVertical="@dimen/spacing_1"
                        android:text="@string/available"
                        android:textColor="@color/text_on_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_2"
                        android:background="@drawable/bg_badge_green"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:paddingHorizontal="@dimen/spacing_2"
                        android:paddingVertical="@dimen/spacing_1"
                        android:text="@string/suggested_field_type_7"
                        android:textColor="@color/badge_green_text"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Name + Rating row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvFieldName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_heading2"
                        android:textStyle="bold"
                        android:fontFamily="@font/bricolage_grotesque"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Sân Trần Bình" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end"
                        android:layout_marginStart="@dimen/spacing_3">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/star_yellow"
                                android:contentDescription="@string/cd_field_rating" />

                            <TextView
                                android:id="@+id/tvRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body_large"
                                android:textStyle="bold"
                                android:fontFamily="@font/be_vietnam_pro"
                                tools:text="4.8" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvReviewCountHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_count_hint"
                            android:textColor="@color/text_hint"
                            android:textSize="@dimen/text_caption"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>
                </LinearLayout>


                <!-- Price -->
                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_heading3"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque"
                    tools:text="350.000đ/giờ" />

                <!-- Description -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_medium"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:lineSpacingMultiplier="1.5"
                    tools:text="Sân cỏ nhân tạo chất lượng cao, có đèn chiếu sáng ban đêm." />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/background_secondary" />

            <!-- Date Selection Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_4"
                android:background="@color/background_primary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_date"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading4"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDateChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:clipToPadding="false"
                    android:orientation="horizontal" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border" />

            <!-- Time Slots Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_4"
                android:background="@color/background_primary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_time"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading4"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTimeSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/btnShowMoreSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:gravity="center"
                    android:padding="@dimen/spacing_2"
                    android:text="@string/action_show_more_slots"
                    android:textColor="@color/primary_dark"
                    android:textSize="@dimen/text_body_medium"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:visibility="gone" />

                <!-- Empty time slots state -->
                <TextView
                    android:id="@+id/tvNoSlots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:gravity="center"
                    android:text="Không có khung giờ trống"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_body_medium"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:visibility="gone" />

                <!-- Loading indicator for slots -->
                <ProgressBar
                    android:id="@+id/pbSlots"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border" />

            <!-- Amenities Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_4"
                android:background="@color/background_primary">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amenities_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading4"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/spacing_3"
                        android:background="@drawable/bg_time_slot_available">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/primary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_2"
                            android:text="@string/amenity_light"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_2"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/spacing_3"
                        android:background="@drawable/bg_time_slot_available">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/primary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_2"
                            android:text="@string/amenity_camera"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/spacing_3"
                        android:background="@drawable/bg_time_slot_available">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/primary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_2"
                            android:text="@string/amenity_water"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_2"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/spacing_3"
                        android:background="@drawable/bg_time_slot_available">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/primary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_2"
                            android:text="@string/amenity_locker"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/spacing_3"
                        android:background="@drawable/bg_time_slot_available">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/primary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_2"
                            android:text="@string/amenity_parking"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_2"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="@dimen/spacing_3"
                        android:background="@drawable/bg_time_slot_available">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check"
                            app:tint="@color/primary"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_2"
                            android:text="@string/amenity_cafe"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border" />

            <!-- Reviews Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_4"
                android:background="@color/background_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvReviewsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/reviews_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_heading4"
                        android:textStyle="bold"
                        android:fontFamily="@font/bricolage_grotesque" />

                    <TextView
                        android:id="@+id/btnViewAllReviews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_view_all"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFieldReviewsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:gravity="center"
                    android:padding="@dimen/spacing_4"
                    android:text="@string/field_reviews_empty"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_body_medium"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFieldReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_customer_field_review"
                    tools:visibility="visible" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardBackgroundColor="@color/background_primary"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_gray">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_4">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_orange"
                                android:gravity="center"
                                android:text="NHL"
                                android:textColor="@color/text_on_primary"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/be_vietnam_pro" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_3"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Nguyễn Hoàng Long"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/text_body_small"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/be_vietnam_pro" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Đá ở đây 6 lần · 2 tuần trước"
                                    android:textColor="@color/text_hint"
                                    android:textSize="@dimen/text_caption"
                                    android:fontFamily="@font/be_vietnam_pro" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_star"
                                    app:tint="@color/star_yellow"
                                    android:contentDescription="@null" />

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_star"
                                    app:tint="@color/star_yellow"
                                    android:contentDescription="@null" />

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_star"
                                    app:tint="@color/star_yellow"
                                    android:contentDescription="@null" />

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_star"
                                    app:tint="@color/star_yellow"
                                    android:contentDescription="@null" />

                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_star"
                                    app:tint="@color/star_yellow"
                                    android:contentDescription="@null" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2"
                            android:text="Cỏ đẹp, đèn sáng, ông chủ vui tính. Sẽ quay lại đá nữa."
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Bottom spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_4" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Book Bar -->
    <LinearLayout
        android:id="@+id/layoutBookBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingVertical="@dimen/spacing_3"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSelectedSlotLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khung giờ đã chọn"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_small"
                android:fontFamily="@font/be_vietnam_pro" />

            <TextView
                android:id="@+id/tvSelectedSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chưa chọn"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold"
                android:fontFamily="@font/be_vietnam_pro" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBook"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_large"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/book_now"
            android:textSize="@dimen/text_body_large"
            android:textStyle="bold"
            android:textColor="@color/text_on_primary"
            android:fontFamily="@font/be_vietnam_pro"
            android:enabled="false"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_button"
            app:elevation="0dp" />

    </LinearLayout>

    <!-- Full-screen loading -->
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminateDrawable="@drawable/bg_custom_loading_spinner"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Error state -->
    <TextView
        android:id="@+id/tvErrorState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_large"
        android:fontFamily="@font/be_vietnam_pro"
        android:layout_marginHorizontal="@dimen/spacing_6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
