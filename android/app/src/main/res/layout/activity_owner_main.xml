<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/ownerFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/ownerBottomNavLayout" />

    <!-- LOADING SPINNER: Đặt ở giữa màn hình -->
    <ProgressBar
        android:id="@+id/ownerLoadingBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/green_primary"
        android:visibility="gone"
        android:elevation="10dp" />

    <include
        android:id="@+id/ownerBottomNavLayout"
        layout="@layout/layout_owner_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
