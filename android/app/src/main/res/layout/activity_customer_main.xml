<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    tools:context=".ui.customer.MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_4"
            android:paddingEnd="@dimen/spacing_4"
            android:paddingTop="@dimen/spacing_6">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="@dimen/spacing_40"
                    android:layout_height="@dimen/spacing_40"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/text_on_primary"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body_medium"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:contentDescription="@string/cd_avatar"
                    android:clickable="true"
                    android:focusable="true"
                    tools:text="TDK" />

                <TextView
                    android:id="@+id/tvHomeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_3"
                    android:text="@string/home_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading3"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <FrameLayout
                    android:layout_width="@dimen/spacing_40"
                    android:layout_height="@dimen/spacing_40">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/radius_pill"
                        app:cardBackgroundColor="@color/background_primary"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/border">

                        <ImageView
                            android:layout_width="@dimen/spacing_20"
                            android:layout_height="@dimen/spacing_20"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bell"
                            app:tint="@color/text_primary"
                            android:contentDescription="@string/cd_notifications" />
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:id="@+id/viewNotificationDot"
                        android:layout_width="@dimen/spacing_2"
                        android:layout_height="@dimen/spacing_2"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="@dimen/spacing_1"
                        android:layout_marginEnd="@dimen/spacing_1"
                        android:background="@drawable/bg_dot_orange" />
                </FrameLayout>
            </LinearLayout>

            <!-- Hero -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                app:cardCornerRadius="@dimen/radius_2xl"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_header_hero"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_6">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_greeting_prefix"
                        android:textColor="@color/text_on_primary"
                        android:textSize="@dimen/text_body_small"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:alpha="0.9" />

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_2"
                        android:text="@string/home_greeting_question"
                        android:textColor="@color/text_on_primary"
                        android:textSize="@dimen/text_heading2"
                        android:textStyle="bold"
                        android:fontFamily="@font/bricolage_grotesque"
                        android:maxLines="2"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="@dimen/home_hero_title_min"
                        android:autoSizeMaxTextSize="@dimen/home_hero_title_max"
                        android:autoSizeStepGranularity="@dimen/home_auto_size_step" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_5"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSearchNearby"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_weight="1.4"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/action_search_nearby"
                            android:textColor="@color/primary_text"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="@dimen/home_button_text_min"
                            android:autoSizeMaxTextSize="@dimen/home_button_text_max"
                            android:autoSizeStepGranularity="@dimen/home_auto_size_step"
                            app:cornerRadius="@dimen/radius_button"
                            app:backgroundTint="@color/background_primary"
                            app:icon="@drawable/ic_search"
                            app:iconTint="@color/primary_text"
                            app:iconPadding="@dimen/spacing_2"
                            app:elevation="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMatchmaking"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_3"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/action_matchmaking"
                            android:textColor="@color/text_on_primary"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="@dimen/home_button_text_min"
                            android:autoSizeMaxTextSize="@dimen/home_button_text_max"
                            android:autoSizeStepGranularity="@dimen/home_auto_size_step"
                            app:cornerRadius="@dimen/radius_button"
                            app:backgroundTint="@color/primary_dark"
                            app:icon="@drawable/ic_bolt"
                            app:iconTint="@color/text_on_primary"
                            app:iconPadding="@dimen/spacing_2"
                            app:elevation="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Upcoming booking summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lịch sắp tới"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading4"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:id="@+id/tvUpcomingSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_view_all"
                    android:textColor="@color/primary_dark"
                    android:textSize="@dimen/text_body_small"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_3"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardBackgroundColor="@color/background_primary"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_gray">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_4">

                    <FrameLayout
                        android:layout_width="@dimen/spacing_48"
                        android:layout_height="@dimen/spacing_48"
                        android:background="@drawable/bg_pitch_cover">

                        <ImageView
                            android:layout_width="@dimen/spacing_20"
                            android:layout_height="@dimen/spacing_20"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/text_on_primary"
                            android:contentDescription="@string/cd_nav_bookings" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUpcomingFieldName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            android:fontFamily="@font/bricolage_grotesque"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvUpcomingTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:text="@string/hot_match_time"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:paddingHorizontal="@dimen/spacing_2"
                        android:paddingVertical="@dimen/spacing_1"
                        android:text="@string/status_confirmed"
                        android:textColor="@color/badge_green_text"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_5"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardBackgroundColor="@color/background_primary"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_4">

                        <TextView
                            android:id="@+id/tvUpcomingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_heading3"
                            android:textStyle="bold"
                            android:fontFamily="@font/bricolage_grotesque"
                            tools:text="2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:text="@string/stat_upcoming_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_3"
                    android:layout_marginEnd="@dimen/spacing_3"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardBackgroundColor="@color/background_primary"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_4">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvTrustScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_heading3"
                                android:textStyle="bold"
                                android:fontFamily="@font/bricolage_grotesque"
                                tools:text="92" />

                            <TextView
                                android:id="@+id/tvTrustScoreMax"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_1"
                                android:text="@string/trust_score_suffix"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_body_small"
                                android:fontFamily="@font/be_vietnam_pro" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:text="@string/stat_trust_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardBackgroundColor="@color/background_primary"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_4">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvMessageCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_heading3"
                                android:textStyle="bold"
                                android:fontFamily="@font/bricolage_grotesque"
                                tools:text="3" />

                            <TextView
                                android:id="@+id/tvMessageBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_1"
                                android:paddingStart="@dimen/spacing_2"
                                android:paddingEnd="@dimen/spacing_2"
                                android:paddingTop="@dimen/spacing_1"
                                android:paddingBottom="@dimen/spacing_1"
                                android:background="@drawable/bg_badge_orange"
                                android:text="@string/label_new"
                                android:textColor="@color/badge_orange_text"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold"
                                android:fontFamily="@font/be_vietnam_pro" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:text="@string/stat_messages_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Hot matches section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvHotSection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_hot_matches"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading4"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:id="@+id/tvHotSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_view_all"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_body_small"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHotMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_3"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardBackgroundColor="@color/background_primary"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_4">

                    <FrameLayout
                        android:layout_width="@dimen/spacing_48"
                        android:layout_height="@dimen/spacing_48">

                        <TextView
                            android:id="@+id/tvHotMatchAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_orange"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/text_on_primary"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_body_medium"
                            android:fontFamily="@font/be_vietnam_pro"
                            tools:text="NHL" />

                        <TextView
                            android:id="@+id/tvHotMatchScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="@dimen/home_badge_overlap"
                            android:layout_marginBottom="@dimen/home_badge_overlap"
                            android:paddingStart="@dimen/spacing_1"
                            android:paddingEnd="@dimen/spacing_1"
                            android:paddingTop="@dimen/spacing_1"
                            android:paddingBottom="@dimen/spacing_1"
                            android:background="@drawable/bg_badge_green"
                            android:text=""
                            android:textColor="@color/badge_green_text"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold"
                            android:fontFamily="@font/be_vietnam_pro"
                            tools:text="92" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_4"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvHotMatchTeam"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hot_match_team_name"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body_large"
                                android:textStyle="bold"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tvHotMatchLive"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_2"
                                android:paddingStart="@dimen/spacing_2"
                                android:paddingEnd="@dimen/spacing_2"
                                android:paddingTop="@dimen/spacing_1"
                                android:paddingBottom="@dimen/spacing_1"
                                android:background="@drawable/bg_badge_orange"
                                android:text="@string/match_live"
                                android:textColor="@color/badge_orange_text"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold"
                                android:fontFamily="@font/be_vietnam_pro" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHotMatchTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:text="@string/hot_match_time"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvHotMatchLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:text="@string/hot_match_level"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="@dimen/spacing_16"
                                android:layout_height="@dimen/spacing_16"
                                android:src="@drawable/ic_map_pin"
                                app:tint="@color/text_secondary"
                                android:contentDescription="@string/cd_map_pin" />

                            <TextView
                                android:id="@+id/tvHotMatchLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_1"
                                android:text="@string/hot_match_location"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_body_small"
                                android:fontFamily="@font/be_vietnam_pro"
                                android:maxLines="1"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHotMatchAccept"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height_small"
                        android:layout_marginStart="@dimen/spacing_3"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/action_accept_match"
                        android:textColor="@color/text_on_primary"
                        android:textSize="@dimen/text_body_small"
                        android:textStyle="bold"
                        android:fontFamily="@font/be_vietnam_pro"
                        app:cornerRadius="@dimen/radius_button"
                        app:backgroundTint="@color/accent_orange"
                        app:elevation="0dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Suggested fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSuggestedSection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_suggested_fields"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading4"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:id="@+id/tvSuggestedMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_view_more"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_body_small"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSuggestedFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_3"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/spacing_6"
                android:paddingEnd="@dimen/spacing_2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:layout_marginBottom="@dimen/spacing_6"
                android:background="@drawable/bg_pitch_tint_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_4">

                <TextView
                    android:layout_width="@dimen/spacing_40"
                    android:layout_height="@dimen/spacing_40"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="!"
                    android:textColor="@color/text_on_primary"
                    android:textSize="@dimen/text_heading4"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Giờ vàng đặt nhanh"
                        android:textColor="@color/pitch_900"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold"
                        android:fontFamily="@font/bricolage_grotesque" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_1"
                        android:text="Khung 19:00-21:00 thường hết sân sớm. Đặt trước để giữ chỗ tối nay."
                        android:textColor="@color/pitch_800"
                        android:textSize="@dimen/text_body_small"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:lineSpacingMultiplier="1.35" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFloatingBook"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:layout_marginEnd="@dimen/spacing_4"
        android:layout_marginBottom="@dimen/spacing_64"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/book_now"
        android:textColor="@color/text_on_primary"
        android:textSize="@dimen/text_body_medium"
        android:textStyle="bold"
        android:fontFamily="@font/be_vietnam_pro"
        app:cornerRadius="@dimen/radius_button"
        app:backgroundTint="@color/accent_orange"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/text_on_primary"
        app:iconPadding="@dimen/spacing_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:elevation="0dp" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_customer_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
