<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    tools:context=".ui.customer.MainActivity">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_4"
        android:paddingTop="@dimen/spacing_4"
        android:paddingEnd="@dimen/spacing_4"
        android:paddingBottom="@dimen/spacing_4"
        android:background="@color/background_primary"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="@dimen/spacing_40"
            android:layout_height="@dimen/spacing_40"
            android:background="@drawable/bg_avatar_circle"
            android:clickable="true"
            android:contentDescription="@string/cd_avatar"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_body_medium"
            android:textStyle="bold"
            tools:text="TD" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/bricolage_grotesque"
                android:maxLines="1"
                android:text="@string/home_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_heading4"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro"
                android:maxLines="1"
                android:text="@string/home_ready_to_book"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_medium" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="@dimen/spacing_40"
            android:layout_height="@dimen/spacing_40">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNotifications"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/background_primary"
                app:cardCornerRadius="@dimen/radius_pill"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="@dimen/spacing_20"
                    android:layout_height="@dimen/spacing_20"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_notifications"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/primary" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:id="@+id/viewNotificationDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_dot_orange"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/border_gray"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_4"
            android:paddingTop="@dimen/spacing_4"
            android:paddingEnd="@dimen/spacing_4">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/radius_2xl"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_header_hero"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_6">

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="@dimen/home_hero_title_max"
                        android:autoSizeMinTextSize="@dimen/home_hero_title_min"
                        android:autoSizeStepGranularity="@dimen/home_auto_size_step"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/bricolage_grotesque"
                        android:maxLines="2"
                        android:text="@string/home_booking_headline"
                        android:textColor="@color/text_on_primary"
                        android:textSize="@dimen/text_heading2"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_2"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:lineSpacingMultiplier="1.35"
                        android:text="@string/home_booking_subtitle"
                        android:textColor="@color/text_on_primary"
                        android:textSize="@dimen/text_body_medium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_5"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSearchNearby"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:maxLines="1"
                            android:text="@string/action_search_nearby"
                            android:textColor="@color/primary_text"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            app:backgroundTint="@color/background_primary"
                            app:cornerRadius="@dimen/radius_button"
                            app:elevation="0dp"
                            app:icon="@drawable/ic_search"
                            app:iconPadding="@dimen/spacing_2"
                            app:iconTint="@color/primary_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHomeBookings"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginStart="@dimen/spacing_3"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:maxLines="1"
                            android:text="@string/nav_bookings_label"
                            android:textColor="@color/text_on_primary"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary_dark"
                            app:cornerRadius="@dimen/radius_button"
                            app:elevation="0dp"
                            app:icon="@drawable/ic_calendar"
                            app:iconPadding="@dimen/spacing_2"
                            app:iconTint="@color/text_on_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_5"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/background_primary"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_4">

                        <TextView
                            android:id="@+id/tvUpcomingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bricolage_grotesque"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_heading3"
                            android:textStyle="bold"
                            tools:text="2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="@string/stat_upcoming_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_3"
                    android:layout_marginEnd="@dimen/spacing_3"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/background_primary"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_4">

                        <TextView
                            android:id="@+id/tvTrustScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bricolage_grotesque"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_heading3"
                            android:textStyle="bold"
                            tools:text="100" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="@string/stat_trust_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/background_primary"
                    app:cardCornerRadius="@dimen/radius_card"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_4">

                        <TextView
                            android:id="@+id/tvNotificationCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bricolage_grotesque"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_heading3"
                            android:textStyle="bold"
                            tools:text="3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="@string/stat_notifications_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_5"
                android:background="@color/border_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/bricolage_grotesque"
                    android:text="@string/home_next_booking_title"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading4"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUpcomingSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/action_view_all"
                    android:textColor="@color/primary_dark"
                    android:textSize="@dimen/text_body_small"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNextBooking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_3"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/background_primary"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_gray"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_4">

                    <FrameLayout
                        android:layout_width="@dimen/spacing_48"
                        android:layout_height="@dimen/spacing_48"
                        android:background="@drawable/bg_pitch_cover">

                        <ImageView
                            android:layout_width="@dimen/spacing_20"
                            android:layout_height="@dimen/spacing_20"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_nav_bookings"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/text_on_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUpcomingFieldName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/bricolage_grotesque"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            tools:text="San Trung Tam" />

                        <TextView
                            android:id="@+id/tvUpcomingTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:ellipsize="end"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small"
                            tools:text="2026-06-15 18:00-19:30" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUpcomingStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:paddingStart="@dimen/spacing_2"
                        android:paddingTop="@dimen/spacing_1"
                        android:paddingEnd="@dimen/spacing_2"
                        android:paddingBottom="@dimen/spacing_1"
                        android:textColor="@color/badge_green_text"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="Confirmed" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPaymentReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_3"
                app:cardBackgroundColor="@color/background_primary"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_gray"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_4">

                    <FrameLayout
                        android:layout_width="@dimen/spacing_48"
                        android:layout_height="@dimen/spacing_48"
                        android:background="@drawable/bg_notification_icon">

                        <ImageView
                            android:layout_width="@dimen/spacing_20"
                            android:layout_height="@dimen/spacing_20"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_payment_method_icon"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPaymentReminderTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/bricolage_grotesque"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body_medium"
                            android:textStyle="bold"
                            tools:text="Can thanh toan coc" />

                        <TextView
                            android:id="@+id/tvPaymentReminderBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:lineSpacingMultiplier="1.35"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_body_small"
                            tools:text="Hoan tat dat coc de giu san." />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPaymentReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height_small"
                        android:layout_marginStart="@dimen/spacing_3"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/action_pay_deposit"
                        android:textColor="@color/text_on_primary"
                        android:textSize="@dimen/text_body_small"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent_orange"
                        app:cornerRadius="@dimen/radius_button"
                        app:elevation="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_5"
                android:background="@color/border_gray" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSuggestedSection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/bricolage_grotesque"
                    android:text="@string/section_suggested_fields"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading4"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSuggestedMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/action_view_more"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_body_small"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSuggestedFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_3"
                android:clipToPadding="false"
                android:paddingEnd="@dimen/spacing_2"
                android:paddingBottom="@dimen/spacing_6" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_4"
                android:background="@color/border_gray" />

            <LinearLayout
                android:id="@+id/layoutBookingTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:layout_marginBottom="@dimen/spacing_6"
                android:background="@drawable/bg_pitch_tint_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_4">

                <ImageView
                    android:layout_width="@dimen/spacing_40"
                    android:layout_height="@dimen/spacing_40"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="@string/cd_booking_confirm"
                    android:padding="@dimen/spacing_2"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/text_on_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bricolage_grotesque"
                        android:text="@string/home_booking_tip_title"
                        android:textColor="@color/pitch_900"
                        android:textSize="@dimen/text_body_medium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:lineSpacingMultiplier="1.35"
                        android:text="@string/home_booking_tip_body"
                        android:textColor="@color/pitch_800"
                        android:textSize="@dimen/text_body_small" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

