<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fieldManagementRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/slate_100">

    <LinearLayout
        android:id="@+id/fieldMgmtHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:elevation="2dp">


        <!-- Title row: "My Football Fields" + FAB -->
        <LinearLayout
            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:orientation="horizontal"

            android:gravity="center_vertical"

            android:layout_marginBottom="14dp">



            <LinearLayout

                android:layout_width="0dp"

                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:orientation="vertical">



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="Management"

                    android:textColor="@color/slate_400"

                    android:textSize="11sp"

                    android:textStyle="bold"

                    android:letterSpacing="0.05"

                    android:textAllCaps="true" />



                <TextView

                    android:layout_width="wrap_content"

                    android:layout_height="wrap_content"

                    android:text="@string/fields_title"

                    android:textColor="@color/slate_900"

                    android:textSize="19sp"

                    android:textStyle="bold"

                    android:layout_marginTop="2dp" />



            </LinearLayout>



            <!-- FAB: Add New Field -->

            <LinearLayout
                android:id="@+id/fabAddField"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_fab"
                android:gravity="center"
                android:elevation="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />



            </LinearLayout>



        </LinearLayout>



        <!-- Search bar -->

        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="44dp"

            android:orientation="horizontal"

            android:gravity="center_vertical"

            android:background="@drawable/bg_search_bar"

            android:paddingStart="14dp"

            android:paddingEnd="14dp"

            android:layout_marginBottom="10dp">



            <ImageView

                android:layout_width="15dp"

                android:layout_height="15dp"

                android:src="@android:drawable/ic_menu_search"

                app:tint="@color/slate_400"

                android:layout_marginEnd="10dp" />



            <EditText

                android:id="@+id/etSearchFields"

                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/fields_search_hint"
                android:textColorHint="@color/slate_400"
                android:textColor="@color/slate_700"
                android:textSize="13sp"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch" />
        </LinearLayout>



        <!-- Summary pills row -->

        <LinearLayout

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:orientation="horizontal">



            <!-- Available pill -->

            <TextView

                android:id="@+id/tvAvailableCount"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="● 4 Available"

                android:textColor="@color/emerald_700"

                android:textSize="11sp"

                android:textStyle="bold"

                android:background="@drawable/bg_status_completed"

                android:paddingStart="10dp"

                android:paddingEnd="10dp"

                android:paddingTop="3dp"

                android:paddingBottom="3dp"

                android:layout_marginEnd="10dp" />



            <!-- Maintenance pill -->

            <TextView

                android:id="@+id/tvMaintenanceCount"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="● 2 Maintenance"

                android:textColor="@color/orange_700"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_maintenance"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOwnerEmptyFields"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Chưa có sân nào. Hãy tạo sân đầu tiên."
            android:textColor="@color/slate_400"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ══════════════════════════════════════════════════
         FIELD CARDS RecyclerView
         Adapter  : FieldCardAdapter
         Item XML : item_field_card.xml
         Manager  : LinearLayoutManager(context, VERTICAL, false)
         ══════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFieldList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay" />
</LinearLayout>
