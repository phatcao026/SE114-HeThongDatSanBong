<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_primary"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_6"
        android:paddingBottom="@dimen/spacing_8">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_2"
            android:layout_marginBottom="@dimen/spacing_4"
            android:background="@color/border" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_6">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_heading3"
                android:textStyle="bold"
                android:fontFamily="@font/bricolage_grotesque" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close_filter"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Loại sân -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_field_type"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_large"
            android:textStyle="bold"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_marginBottom="@dimen/spacing_2" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_6"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTypeAll"
                style="@style/Widget.TimSanBong.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_all"
                android:textColor="@color/chip_text_color_state"
                android:fontFamily="@font/be_vietnam_pro"
                app:chipBackgroundColor="@color/chip_bg_color_state"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipType5"
                style="@style/Widget.TimSanBong.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_type_5"
                android:textColor="@color/chip_text_color_state"
                android:fontFamily="@font/be_vietnam_pro"
                app:chipBackgroundColor="@color/chip_bg_color_state"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipType7"
                style="@style/Widget.TimSanBong.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_type_7"
                android:textColor="@color/chip_text_color_state"
                android:fontFamily="@font/be_vietnam_pro"
                app:chipBackgroundColor="@color/chip_bg_color_state"
                app:chipStrokeWidth="0dp" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Khoảng giá -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_price_range"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_large"
            android:textStyle="bold"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_marginBottom="@dimen/spacing_2" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_6"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPriceAll"
                style="@style/Widget.TimSanBong.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_all"
                android:textColor="@color/chip_text_color_state"
                android:fontFamily="@font/be_vietnam_pro"
                app:chipBackgroundColor="@color/chip_bg_color_state"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPriceUnder200"
                style="@style/Widget.TimSanBong.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_price_under_200"
                android:textColor="@color/chip_text_color_state"
                android:fontFamily="@font/be_vietnam_pro"
                app:chipBackgroundColor="@color/chip_bg_color_state"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrice200to300"
                style="@style/Widget.TimSanBong.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_price_200_300"
                android:textColor="@color/chip_text_color_state"
                android:fontFamily="@font/be_vietnam_pro"
                app:chipBackgroundColor="@color/chip_bg_color_state"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPriceOver300"
                style="@style/Widget.TimSanBong.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_price_over_300"
                android:textColor="@color/chip_text_color_state"
                android:fontFamily="@font/be_vietnam_pro"
                app:chipBackgroundColor="@color/chip_bg_color_state"
                app:chipStrokeWidth="0dp" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Trạng thái -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_status"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_large"
            android:textStyle="bold"
            android:fontFamily="@font/be_vietnam_pro"
            android:layout_marginBottom="@dimen/spacing_2" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_6">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAvailableOnly"
                style="@style/Widget.TimSanBong.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_available_only"
                android:textColor="@color/chip_text_color_state"
                android:fontFamily="@font/be_vietnam_pro"
                app:chipBackgroundColor="@color/chip_bg_color_state"
                app:chipStrokeWidth="0dp"
                app:checkedIconVisible="true"
                app:checkedIconTint="@color/primary_text" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_2"
                android:text="@string/filter_reset"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_body_large"
                android:fontFamily="@font/be_vietnam_pro"
                app:cornerRadius="@dimen/radius_button"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="@color/primary_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_2"
                android:text="@string/filter_apply"
                android:textColor="@color/text_on_primary"
                android:textSize="@dimen/text_body_large"
                android:fontFamily="@font/be_vietnam_pro"
                app:cornerRadius="@dimen/radius_button"
                app:backgroundTint="@color/primary"
                app:elevation="@dimen/shadow_elevation_md"
                app:rippleColor="@color/primary_dark" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
