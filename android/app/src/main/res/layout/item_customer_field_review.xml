<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_3"
    app:cardBackgroundColor="@color/background_primary"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_gray"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReviewerInitials"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_orange"
                android:fontFamily="@font/be_vietnam_pro"
                android:gravity="center"
                android:textColor="@color/text_on_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="HL" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvReviewerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_small"
                    android:textStyle="bold"
                    tools:text="Nguyễn Hoàng Long" />

                <TextView
                    android:id="@+id/tvCreatedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_caption"
                    tools:text="20/06/2026" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRatingValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold"
                tools:text="5/5" />
        </LinearLayout>

        <RatingBar
            android:id="@+id/rbReviewRating"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:isIndicator="true"
            android:numStars="5"
            android:stepSize="1"
            android:progressTint="@color/star_yellow"
            android:secondaryProgressTint="@color/star_yellow"
            android:progressBackgroundTint="@color/star_gray"
            tools:rating="5" />

        <TextView
            android:id="@+id/tvComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:fontFamily="@font/be_vietnam_pro"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small"
            tools:text="Cỏ đẹp, đèn sáng, chủ sân nhiệt tình. Sẽ quay lại." />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
