<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_3"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/background_primary"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_4">

        <!-- Header: avatar + info + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar with trust badge -->
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp">

                <View
                    android:id="@+id/viewAvatarBg"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/shape_oval" />

                <TextView
                    android:id="@+id/tvInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/text_on_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro" />

                <TextView
                    android:id="@+id/tvTrustBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|end"
                    android:minWidth="18dp"
                    android:paddingHorizontal="3dp"
                    android:gravity="center"
                    android:textColor="@color/text_on_primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:background="@drawable/bg_trust_badge" />
            </FrameLayout>

            <!-- Team name + badges -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_3"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvTeamName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvLiveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_2"
                        android:text="@string/match_hot_badge"
                        android:textColor="@color/text_on_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:paddingHorizontal="@dimen/spacing_2"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_badge_orange_solid"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:paddingHorizontal="@dimen/spacing_2"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_badge_green" />

                    <TextView
                        android:id="@+id/tvLevelBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_1"
                        android:textColor="@color/badge_neutral_text"
                        android:textSize="11sp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:paddingHorizontal="@dimen/spacing_2"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_badge_neutral" />
                </LinearLayout>
            </LinearLayout>

            <!-- Posted time -->
            <TextView
                android:id="@+id/tvPostedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_2"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:fontFamily="@font/be_vietnam_pro" />
        </LinearLayout>

        <!-- Message text -->
        <TextView
            android:id="@+id/tvMatchMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_3"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:lineSpacingMultiplier="1.45"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Info block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_3">

            <!-- Date + Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/text_hint"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/be_vietnam_pro" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="@dimen/spacing_3"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/text_hint"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/be_vietnam_pro" />
            </LinearLayout>

            <!-- Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_map_pin"
                    app:tint="@color/text_hint"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Cost + Members -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_wallet"
                    app:tint="@color/text_hint"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvCost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/be_vietnam_pro" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="@dimen/spacing_3"
                    android:src="@drawable/ic_group"
                    app:tint="@color/text_hint"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvMembers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/be_vietnam_pro" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_3"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAccept"
                style="@style/Widget.TimSanBong.Button.Flood"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_small"
                android:layout_weight="1"
                android:text="@string/match_action_accept"
                android:textColor="@color/text_on_primary"
                android:textSize="13sp"
                android:fontFamily="@font/be_vietnam_pro"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/accent_orange"
                app:cornerRadius="@dimen/radius_button"
                app:rippleColor="@color/accent_orange_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChatMatch"
                style="@style/Widget.TimSanBong.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:layout_marginStart="@dimen/spacing_2"
                android:text="@string/match_action_chat"
                android:textColor="@color/primary_dark"
                android:textSize="13sp"
                android:fontFamily="@font/be_vietnam_pro"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="@color/primary_dark"
                app:cornerRadius="@dimen/radius_button" />

            <TextView
                android:id="@+id/tvAccepted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/match_accepted"
                android:textColor="@color/success"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/be_vietnam_pro"
                android:gravity="center"
                android:paddingVertical="@dimen/spacing_2"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
