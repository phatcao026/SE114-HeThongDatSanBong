<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    tools:context=".ui.profile.ProfileActivity">

    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_secondary"
        android:orientation="vertical"
        android:padding="@dimen/spacing_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_heading1"
            android:textStyle="bold"
            android:fontFamily="@font/inter" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_4"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="@dimen/shadow_elevation_md"
        app:cardBackgroundColor="@color/background_primary"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_6">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_heading2"
                android:textStyle="bold"
                android:fontFamily="@font/inter" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_medium" />

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMyBookings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_6"
                android:text="@string/my_bookings"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold"
                android:textColor="@color/text_on_primary"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/radius_button"
                app:elevation="@dimen/shadow_elevation_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminPanel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_3"
                android:text="Admin Panel"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold"
                android:textColor="@color/text_on_primary"
                app:backgroundTint="@color/accent_orange"
                app:cornerRadius="@dimen/radius_button"
                app:elevation="@dimen/shadow_elevation_md" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_3"
                android:text="@string/logout"
                android:textSize="@dimen/text_body_large"
                android:textColor="@color/error"
                app:cornerRadius="@dimen/radius_button"
                app:strokeColor="@color/error" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
