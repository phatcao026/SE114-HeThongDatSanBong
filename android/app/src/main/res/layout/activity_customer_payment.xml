<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    android:padding="@dimen/spacing_6"
    tools:context=".ui.customer.PaymentActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/payment_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_heading1"
        android:textStyle="bold"
        android:fontFamily="@font/bricolage_grotesque"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_6"
        app:cardCornerRadius="@dimen/radius_card"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/background_primary"
        app:strokeColor="@color/border_gray"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_6">

            <TextView
                android:id="@+id/tvBookingRef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_body_medium"
                android:fontFamily="@font/be_vietnam_pro"
                tools:text="Mã đơn: #BK-1024" />

            <TextView
                android:id="@+id/tvFieldName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_heading4"
                android:textStyle="bold"
                android:fontFamily="@font/bricolage_grotesque"
                tools:text="Sân Bóng A" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Giá trị sân:"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_medium"
                    android:fontFamily="@font/be_vietnam_pro" />

                <TextView
                    android:id="@+id/tvTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_medium"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro"
                    tools:text="350.000 đ" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tiền cọc giữ sân:"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_medium"
                    android:textStyle="bold"
                    android:fontFamily="@font/be_vietnam_pro" />

                <TextView
                    android:id="@+id/tvDepositAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_heading3"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque"
                    tools:text="105.000 đ" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Còn lại tại sân:"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_medium"
                    android:fontFamily="@font/be_vietnam_pro" />

                <TextView
                    android:id="@+id/tvRemainderAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_medium"
                    android:fontFamily="@font/be_vietnam_pro"
                    tools:text="245.000 đ" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_4"
                android:background="@color/border_gray" />

            <TextView
                android:id="@+id/tvStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_3"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_medium"
                android:fontFamily="@font/be_vietnam_pro" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPay"
                style="@style/Widget.TimSanBong.Button.Filled"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_large"
                android:layout_marginTop="@dimen/spacing_6"
                android:text="@string/action_pay_now"
                android:textSize="@dimen/text_body_large"
                android:textStyle="bold"
                android:textColor="@color/text_on_primary"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/radius_button"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewBookings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_3"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/action_view_bookings"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_body_medium"
                android:visibility="gone"
                app:cornerRadius="@dimen/radius_button"
                app:strokeColor="@color/primary" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:text="@string/empty_payment"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_large"
        android:fontFamily="@font/be_vietnam_pro"
        android:layout_marginHorizontal="@dimen/spacing_6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvErrorState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_large"
        android:fontFamily="@font/be_vietnam_pro"
        android:layout_marginHorizontal="@dimen/spacing_6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

