<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    tools:context=".ui.auth.LoginActivity">

    <ImageView
        android:id="@+id/ivHeader"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:background="@color/primary_light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
        android:layout_marginBottom="@dimen/overlap_wave" />

    <ImageView
        android:id="@+id/ivWave"
        android:layout_width="0dp"
        android:layout_height="@dimen/spacing_96"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/bg_wave"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_top"
        android:padding="@dimen/spacing_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng nhập"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_heading1"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            android:layout_marginHorizontal="@dimen/spacing_4"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_4"
            android:layout_marginTop="@dimen/spacing_5"
            android:hint="Email"
            app:boxCornerRadiusBottomEnd="@dimen/radius_button"
            app:boxCornerRadiusBottomStart="@dimen/radius_button"
            app:boxCornerRadiusTopEnd="@dimen/radius_button"
            app:boxCornerRadiusTopStart="@dimen/radius_button"
            app:boxStrokeColor="@color/border"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textSize="@dimen/text_body_medium"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_4"
            android:layout_marginTop="@dimen/spacing_3"
            android:hint="Mật khẩu"
            app:endIconMode="password_toggle"
            app:boxCornerRadiusBottomEnd="@dimen/radius_button"
            app:boxCornerRadiusBottomStart="@dimen/radius_button"
            app:boxCornerRadiusTopEnd="@dimen/radius_button"
            app:boxCornerRadiusTopStart="@dimen/radius_button"
            app:boxStrokeColor="@color/border"
            app:layout_constraintTop_toBottomOf="@+id/tilEmail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textSize="@dimen/text_body_medium"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:layout_marginEnd="@dimen/spacing_4"
            android:text="Quên mật khẩu?"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small"
            android:fontFamily="@font/inter"
            app:layout_constraintTop_toBottomOf="@+id/tilPassword"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginHorizontal="@dimen/spacing_4"
            android:layout_marginTop="@dimen/spacing_5"
            android:text="Đăng nhập"
            android:textSize="@dimen/text_body_large"
            android:textStyle="bold"
            android:textColor="@color/text_on_primary"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_button"
            app:elevation="@dimen/shadow_elevation_md"
            app:layout_constraintTop_toBottomOf="@+id/tvForgotPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvRegisterLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_5"
            android:layout_marginBottom="@dimen/spacing_4"
            android:text="Chưa có tài khoản? Đăng ký ngay"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_body_medium"
            android:fontFamily="@font/inter"
            app:layout_constraintTop_toBottomOf="@+id/btnLogin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
