<?xml version="1.0" encoding="utf-8"?>
<!--
    item_recent_booking.xml  ─  RecentBookingAdapter.ViewHolder
    Used in: fragment_dashboard.xml → rvRecentBookings (max 5 items)
    Displays: Avatar · Customer name · Field · Time slot · Status pill
    Java binding (RecentBookingAdapter.java):
      tvAvatarLetter   → booking.getCustomer().charAt(last word) uppercased
      viewAvatarBg     → setBackgroundColor(booking.getAvatarColor())
      tvCustomerName   → booking.getCustomer()
      tvFieldAndSlot   → "Sân A1 · Sân 5 · 18:00 – 19:30"
      tvStatusPill     → booking.getStatus()
      tvStatusPill.bg  → set correct drawable per status
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recentBookingItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/white"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="8dp"
    android:elevation="1dp">

    <!--
        NOTE: The rounded-card background is applied via MaterialCardView parent in the adapter.
        Alternatively wrap this LinearLayout inside a MaterialCardView with cornerRadius=16dp.
    -->

    <!-- Customer Avatar circle (tint background with customer color in Java) -->
    <FrameLayout
        android:id="@+id/frameRecentBookingAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="12dp">

        <!-- Circle bg — set color programmatically via GradientDrawable -->
        <View
            android:id="@+id/viewAvatarBg"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_avatar_green" />

        <TextView
            android:id="@+id/tvAvatarLetter"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="A"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

    </FrameLayout>

    <!-- Customer name + field / slot info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRecentCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nguyễn Văn Anh"
            android:textColor="@color/slate_900"
            android:textSize="12sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvRecentFieldAndSlot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sân A1 · Sân 5 · 18:00 – 19:30"
            android:textColor="@color/slate_400"
            android:textSize="10sp"
            android:layout_marginTop="3dp" />

    </LinearLayout>

    <!-- Status pill (set background drawable programmatically per status) -->
    <LinearLayout
        android:id="@+id/containerRecentStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_status_pending">

        <!-- Colour dot (set tint in Java based on status) -->
        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_badge_orange"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tvRecentStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:text="Pending"
            android:textAlignment="center"
            android:gravity="center"
            android:textColor="@color/amber_600"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
