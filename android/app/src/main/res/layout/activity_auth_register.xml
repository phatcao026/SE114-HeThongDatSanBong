<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    tools:context=".ui.auth.RegisterActivity">

    <ImageView
        android:id="@+id/ivHeader"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/primary_light"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:layout_marginBottom="@dimen/overlap_wave"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainer" />

    <ImageView
        android:id="@+id/ivWave"
        android:layout_width="0dp"
        android:layout_height="@dimen/spacing_96"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/bg_wave"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/bottomContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background_primary"
        android:fillViewport="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ViewFlipper
            android:id="@+id/registerViewFlipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_6">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading1"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilName"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:hint="@string/full_name"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                    app:boxCornerRadiusBottomStart="@dimen/radius_button"
                    app:boxCornerRadiusTopEnd="@dimen/radius_button"
                    app:boxCornerRadiusTopStart="@dimen/radius_button"
                    app:boxStrokeColor="@color/border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:hint="@string/email"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                    app:boxCornerRadiusBottomStart="@dimen/radius_button"
                    app:boxCornerRadiusTopEnd="@dimen/radius_button"
                    app:boxCornerRadiusTopStart="@dimen/radius_button"
                    app:boxStrokeColor="@color/border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:hint="@string/password"
                    app:endIconMode="password_toggle"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                    app:boxCornerRadiusBottomStart="@dimen/radius_button"
                    app:boxCornerRadiusTopEnd="@dimen/radius_button"
                    app:boxCornerRadiusTopStart="@dimen/radius_button"
                    app:boxStrokeColor="@color/border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmPassword"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:hint="Xác nhận mật khẩu"
                    app:endIconMode="password_toggle"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                    app:boxCornerRadiusBottomStart="@dimen/radius_button"
                    app:boxCornerRadiusTopEnd="@dimen/radius_button"
                    app:boxCornerRadiusTopStart="@dimen/radius_button"
                    app:boxStrokeColor="@color/border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendRegisterOtp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_5"
                    android:text="Gửi OTP"
                    android:textSize="@dimen/text_body_large"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_primary"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="@dimen/radius_button"
                    app:elevation="@dimen/shadow_elevation_md" />

                <TextView
                    android:id="@+id/tvLoginLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:layout_marginBottom="@dimen/spacing_4"
                    android:gravity="center"
                    android:text="Đã có tài khoản? Đăng nhập"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_body_medium"
                    android:fontFamily="@font/be_vietnam_pro" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_6">

                <ImageView
                    android:id="@+id/btnBackFromRegisterOtp"
                    android:layout_width="@dimen/spacing_40"
                    android:layout_height="@dimen/spacing_40"
                    android:padding="@dimen/spacing_2"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/cd_back"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:text="Xác thực email"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_heading1"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:id="@+id/tvRegisterOtpHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_2"
                    android:text="Nhập mã OTP đã gửi đến email của bạn."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_medium"
                    android:fontFamily="@font/be_vietnam_pro" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegisterOtp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_5"
                    android:hint="OTP"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_button"
                    app:boxCornerRadiusBottomStart="@dimen/radius_button"
                    app:boxCornerRadiusTopEnd="@dimen/radius_button"
                    app:boxCornerRadiusTopStart="@dimen/radius_button"
                    app:boxStrokeColor="@color/border">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="6"
                        android:textSize="@dimen/text_body_medium"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_5"
                    android:text="Tạo tài khoản"
                    android:textSize="@dimen/text_body_large"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_primary"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="@dimen/radius_button"
                    app:elevation="@dimen/shadow_elevation_md" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResendRegisterOtp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_3"
                    android:text="Gửi lại OTP"
                    android:textSize="@dimen/text_body_medium"
                    android:textColor="@color/primary"
                    app:cornerRadius="@dimen/radius_button"
                    app:strokeColor="@color/primary"
                    app:elevation="0dp" />
            </LinearLayout>
        </ViewFlipper>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
