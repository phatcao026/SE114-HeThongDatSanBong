<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvOwnerSlotTimeRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerInParent="true"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="06:00 - 07:30" />

        <TextView
            android:id="@+id/tvOwnerSlotStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/green_primary"
            android:background="@drawable/bg_tag_emerald"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:gravity="center"
            android:text="Trống" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvOwnerSlotPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/green_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="200,000đ" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F3F4F6"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditOwnerSlot"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Sửa"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/blue_primary"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#EFF6FF"
            app:cornerRadius="8dp"
            app:strokeColor="#DBEAFE"
            app:strokeWidth="1dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteOwnerSlot"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Xóa"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="#EF4444"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#FEE2E2"
            app:cornerRadius="8dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />
    </LinearLayout>
</LinearLayout>