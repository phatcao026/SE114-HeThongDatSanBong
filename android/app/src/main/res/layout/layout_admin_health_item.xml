<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/ivHealthIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_admin_shield"
        app:tint="@color/primary"
        android:contentDescription="Health icon" />

    <TextView
        android:id="@+id/tvHealthLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:text="Tỉ lệ hoàn tất trận"
        android:textColor="@color/text_body"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvHealthValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="94.2%"
        android:textColor="@color/text_heading"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHealthTrend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="+1.2"
        android:textColor="@color/admin_trend_up"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>