<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_edit_field.xml  ─  EditFieldBottomSheetFragment
    Trigger: btnEditField click in FieldCardAdapter (item_field_card.xml)
    Usage:
        EditFieldBottomSheetFragment sheet = EditFieldBottomSheetFragment.newInstance(field);
        sheet.show(getSupportFragmentManager(), "EditFieldSheet");
    Java class extends: BottomSheetDialogFragment
    Pre-fill all views using field data passed via Bundle in newInstance().

    Key difference from dialog_create_field.xml:
      - Title is "Chỉnh sửa sân" with the current field name shown
      - Image preview is immediately shown if field has an image
      - Current values are pre-filled in all inputs
      - Save button says "Lưu thay đổi"
      - Shows a "Xóa sân" danger button at the bottom

    On "Lưu thay đổi" → validate → PUT /api/fields/{id} → dismiss + refresh
    On "Xóa sân"       → show ConfirmDeleteDialog → DELETE /api/fields/{id}
    On "Hủy"           → dismiss()
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editFieldSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_container"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- ── Drag handle ── -->
        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_bottom_sheet_handle"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

        <!-- ── Title row ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chỉnh sửa sân"
                    android:textColor="@color/slate_900"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Field name chip — shows which field is being edited -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_info_green"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginTop="5dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_badge_green"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:id="@+id/tvEditingFieldName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sân A1"
                        android:textColor="@color/emerald_700"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Close button -->
            <LinearLayout
                android:id="@+id/btnCloseEditField"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_info_gray"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textColor="@color/slate_500"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Image picker (pre-filled if field has image) ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ảnh sân"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/containerEditImagePicker"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_image_picker"
            android:layout_marginBottom="20dp">

            <!-- No image state -->
            <LinearLayout
                android:id="@+id/llEditNoImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/emerald_500"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chọn ảnh sân"
                    android:textColor="@color/emerald_600"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Image preview state (default VISIBLE for edit) -->
            <FrameLayout
                android:id="@+id/frameEditImagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <!-- Gradient placeholder when no real image (replaces with real ImageView in Java) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gradient_field_1" />

                <ImageView
                    android:id="@+id/ivEditFieldImagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Change photo overlay -->
                <LinearLayout
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="#99000000"
                    android:layout_gravity="bottom">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đổi ảnh"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- ── Tên sân ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên sân  *"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_outlined"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="18dp">

            <EditText
                android:id="@+id/etEditFieldName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:text="Sân A1"
                android:textColor="@color/slate_900"
                android:textSize="14sp"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:imeOptions="actionNext" />

        </LinearLayout>

        <!-- ── Loại sân chips ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loại sân  *"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:id="@+id/chipEditTypeSan5"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_type_chip_inactive">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sân 5"
                    android:textColor="@color/slate_600"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 - 10 người"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipEditTypeSan7"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_type_chip_inactive">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sân 7"
                    android:textColor="@color/slate_600"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7 - 14 người"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/chipEditTypeSan11"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_type_chip_inactive">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sân 11"
                    android:textColor="@color/slate_600"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11 - 22 người"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Số người & Giá thuê ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số người tối đa"
                    android:textColor="@color/slate_700"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_outlined"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <EditText
                        android:id="@+id/etEditCapacity"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:text="10"
                        android:textColor="@color/slate_900"
                        android:textSize="14sp"
                        android:inputType="number"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="người"
                        android:textColor="@color/slate_400"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá thuê / giờ"
                    android:textColor="@color/slate_700"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_outlined"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <EditText
                        android:id="@+id/etEditPricePerSlot"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:text="350000"
                        android:textColor="@color/slate_900"
                        android:textSize="14sp"
                        android:inputType="numberDecimal"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₫"
                        android:textColor="@color/emerald_600"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ── Mô tả ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả sân"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_outlined"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/etEditDescription"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@null"
                android:hint="Mô tả vị trí, tiện ích, cơ sở vật chất…"
                android:textColorHint="@color/slate_400"
                android:textColor="@color/slate_900"
                android:textSize="13sp"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:maxLines="4" />

        </LinearLayout>

        <!-- ── Trạng thái ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trạng thái"
            android:textColor="@color/slate_700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:id="@+id/rbEditStatusAvailable"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_radio_active"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_badge_green"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Available" android:textColor="@color/emerald_700"
                        android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Đang hoạt động" android:textColor="@color/emerald_600"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView android:id="@+id/ivEditCheckAvailable"
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:text="✓" android:textColor="@color/white"
                    android:textSize="12sp" android:gravity="center"
                    android:background="@drawable/bg_badge_green" android:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/rbEditStatusMaintenance"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_radio_inactive"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <View
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_badge_orange"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Maintenance" android:textColor="@color/slate_600"
                        android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Đang bảo trì" android:textColor="@color/slate_400"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView android:id="@+id/ivEditCheckMaintenance"
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:text="✓" android:textColor="@color/white"
                    android:textSize="12sp" android:gravity="center"
                    android:background="@drawable/bg_badge_orange" android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Action buttons ── -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/slate_100" android:layout_marginBottom="16dp" />

        <!-- Save changes + Cancel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:id="@+id/btnCancelEditField"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:background="@drawable/bg_btn_outline_gray">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hủy"
                    android:textColor="@color/slate_600"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSubmitEditField"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_btn_primary_green"
                android:elevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓  Lưu thay đổi"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Delete field danger button -->
        <LinearLayout
            android:id="@+id/btnDeleteFieldFromEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_danger">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/red_500"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xóa sân này"
                android:textColor="@color/red_500"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
