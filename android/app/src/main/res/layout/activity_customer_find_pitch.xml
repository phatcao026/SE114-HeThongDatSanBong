<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary"
    tools:context=".ui.customer.FindPitchActivity">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_4"
        android:paddingTop="@dimen/spacing_6"
        android:paddingEnd="@dimen/spacing_4"
        android:paddingBottom="@dimen/spacing_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_search"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_display"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_1"
            android:text="Lọc theo loại sân, giá và khu vực như prototype."
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_medium"
            android:fontFamily="@font/be_vietnam_pro" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="0dp"
        android:layout_height="@dimen/input_height"
        android:layout_marginHorizontal="@dimen/spacing_4"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_4"
        android:paddingEnd="@dimen/spacing_2"
        android:background="@drawable/bg_search_input"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_hint"
            android:contentDescription="@string/cd_search" />

        <EditText
            android:id="@+id/etSearchFields"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_2"
            android:hint="Tìm sân, quận, khu vực..."
            android:background="@android:color/transparent"
            android:fontFamily="@font/be_vietnam_pro"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="@dimen/text_body_medium" />

        <ImageButton
            android:id="@+id/btnFilter"
            android:layout_width="@dimen/spacing_40"
            android:layout_height="@dimen/spacing_40"
            android:background="@drawable/bg_nav_active_pill"
            android:contentDescription="@string/cd_filter"
            android:padding="@dimen/spacing_2"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/primary_dark" />
    </LinearLayout>



    <!-- Field type chips -->
    <HorizontalScrollView
        android:id="@+id/scrollTypeChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_3"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/layoutSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_4">

            <TextView
                android:id="@+id/chipTypeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_filter_selected"
                android:paddingHorizontal="@dimen/spacing_4"
                android:paddingVertical="@dimen/spacing_2"
                android:text="@string/filter_all"
                android:textColor="@color/primary_dark"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold"
                android:fontFamily="@font/be_vietnam_pro" />

            <TextView
                android:id="@+id/chipType5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_2"
                android:background="@drawable/bg_chip_filter"
                android:paddingHorizontal="@dimen/spacing_4"
                android:paddingVertical="@dimen/spacing_2"
                android:text="@string/suggested_field_type_5"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold"
                android:fontFamily="@font/be_vietnam_pro" />

            <TextView
                android:id="@+id/chipType7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_2"
                android:background="@drawable/bg_chip_filter"
                android:paddingHorizontal="@dimen/spacing_4"
                android:paddingVertical="@dimen/spacing_2"
                android:text="@string/suggested_field_type_7"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold"
                android:fontFamily="@font/be_vietnam_pro" />

            <TextView
                android:id="@+id/chipType11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_2"
                android:background="@drawable/bg_chip_filter"
                android:paddingHorizontal="@dimen/spacing_4"
                android:paddingVertical="@dimen/spacing_2"
                android:text="@string/suggested_field_type_11"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold"
                android:fontFamily="@font/be_vietnam_pro" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layoutMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_4"
        android:layout_marginTop="@dimen/spacing_4"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/scrollTypeChips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvResultCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque"
            tools:text="12 sân phù hợp" />

        <TextView
            android:id="@+id/tvFilterState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_green"
            android:paddingHorizontal="@dimen/spacing_2"
            android:paddingVertical="@dimen/spacing_1"
            android:text="Tất cả"
            android:textColor="@color/badge_green_text"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:fontFamily="@font/be_vietnam_pro" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFields"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_3"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_4"
        android:paddingEnd="@dimen/spacing_4"
        android:paddingBottom="@dimen/nav_container_height"
        app:layout_constraintTop_toBottomOf="@id/layoutMeta"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutMeta"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_6"
        android:gravity="center"
        android:text="@string/empty_fields"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_large"
        android:fontFamily="@font/be_vietnam_pro"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutMeta"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvErrorState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_6"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body_large"
        android:fontFamily="@font/be_vietnam_pro"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutMeta"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_customer_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
