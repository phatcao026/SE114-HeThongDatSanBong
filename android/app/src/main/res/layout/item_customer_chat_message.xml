<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="2dp"
    android:paddingHorizontal="@dimen/spacing_3">

    <!-- System message (center) -->
    <LinearLayout
        android:id="@+id/layoutSystem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSystem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textColor="@color/chat_system_text"
            android:textSize="12sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:paddingHorizontal="@dimen/spacing_4"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_chat_system" />
    </LinearLayout>

    <!-- Them message (left) -->
    <LinearLayout
        android:id="@+id/layoutThem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:paddingEnd="64dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvThemText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:lineSpacingMultiplier="1.45"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:background="@drawable/bg_chat_bubble_them" />

        <TextView
            android:id="@+id/tvThemTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:fontFamily="@font/be_vietnam_pro" />
    </LinearLayout>

    <!-- Me message (right) -->
    <LinearLayout
        android:id="@+id/layoutMe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingStart="64dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_primary"
            android:textSize="14sp"
            android:fontFamily="@font/be_vietnam_pro"
            android:lineSpacingMultiplier="1.45"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:background="@drawable/bg_chat_bubble_me" />

        <TextView
            android:id="@+id/tvMeTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="6dp"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:fontFamily="@font/be_vietnam_pro" />
    </LinearLayout>

</LinearLayout>
