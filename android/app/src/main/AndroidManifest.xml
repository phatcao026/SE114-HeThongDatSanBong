<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_bg"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimSanBong">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="soccer_booking_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_bell" />

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TimSanBong.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TimSanBong.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="timsanbong" android:host="auth" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.FindPitchActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.FieldDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.BookingActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.MyBookingsActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />

        <!-- Customer Activities (from feat/Login-and-Register-Init) -->
        <activity
            android:name=".ui.customer.PaymentActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.PaymentResultActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TimSanBong.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="timsanbong" android:host="payment" android:pathPrefix="/result" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.customer.FindOpponentActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.QuickFindResultsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.MatchmakingActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.MessagesActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.MatchDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.NotificationsActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.CreateMatchPostActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.customer.TeamManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />

        <!-- Owner Activities -->
        <activity
            android:name=".ui.owner.OwnerMainActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <!--ctivity
            android:name=".ui.owner.OwnerFieldManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" /-->
        <!--activity
            android:name=".ui.owner.OwnerBookingActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" /-->

        <!-- Admin Activities (from dev) -->
        <activity
            android:name=".ui.admin.AdminMainActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.admin.AdminUserActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.admin.AdminAuditActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.admin.AdminTransactionActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.admin.AdminProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.admin.AdminBookingActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.admin.AdminFieldActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.admin.AdminReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.admin.AdminMatchPostActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.admin.AdminUserDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />
        <activity
            android:name=".ui.admin.AdminStatsDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.TimSanBong.NoActionBar" />

        <service
            android:name=".service.TimSanBongFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
